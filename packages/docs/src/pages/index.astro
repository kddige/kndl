---
// The landing page, at the site root. One screen of hero: a drawn campsite (Kip is the fire), the
// install command, and a laptop in the foreground running the real web UI. Then four short points
// and the three commands from install to uninstall. Standalone page, not the Starlight layout, so
// it carries the head tags that astro.config.mjs gives the docs pages. Conventions:
// docs/design/docs-style.md, "Landing page".
const base = import.meta.env.BASE_URL
const site = "https://kddige.github.io"
const doc = (path: string) => `${base}${path}`
const img = (name: string) => `${base}landing/${name}.webp`

const installCmd = "curl -fsSL https://raw.githubusercontent.com/kddige/kndl/main/install.sh | sh"

// Stars: fixed positions from a tiny seeded generator, so the sky is the same on every build.
let seed = 11
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
const stars = Array.from({ length: 34 }, () => ({
  x: Math.round(160 + rand() * 1440),
  y: Math.round(rand() * 430),
  r: rand() > 0.9 ? 1.8 : 1.1,
  o: 0.2 + rand() * 0.35,
}))

// Two marshmallows sit at the fire, one each side, on a log seat; the third at the fire is the
// viewer, at the laptop in the foreground. `dir` 1 faces right, towards the fire.
const mallows = [
  { x: 560, y: 836, dir: 1, delay: "0s" },
  { x: 880, y: 836, dir: -1, delay: "-3.1s" },
]

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>kndl · Multiplayer agentic sessions, self-hosted</title>
    <meta name="description" content="kndl is a Hub you host. A team runs coding-agent Sessions in Sandboxes on machines you own, on any Provider's Models: whoever starts a Session drives it, and the team watches it live from the web." />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:title" content="kndl · Multiplayer agentic sessions, self-hosted" />
    <meta property="og:image" content={`${site}${base}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="kndl: multiplayer agentic sessions, self-hosted." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}${base}og.png`} />
    <meta name="theme-color" content="#fbf6ea" />
    <!-- The theme, before first paint: the same localStorage key as the docs pages
         ('dark' | 'light' | '' for auto), so a choice made on either carries to the other.
         Auto is cream paper unless the system asks for dark. -->
    <script is:inline>
      (() => {
        let t
        try { t = localStorage.getItem("starlight-theme") } catch {}
        const dark = t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.dataset.theme = dark ? "dark" : "light"
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#1b1823" : "#fbf6ea")
      })()
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..800,0..100&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <!-- 1. The fire, and you at it. -->
    <section class="hero">
      <header class="top">
        <a class="brand" href={doc("")} aria-label="kndl docs">
          <svg viewBox="24 8 80 114" width="20" height="28" aria-hidden="true">
            <rect x="28" y="100" width="72" height="13" rx="6.5" fill="#6B4A3A" transform="rotate(-11 64 106)" />
            <rect x="28" y="100" width="72" height="13" rx="6.5" fill="#8C5F47" transform="rotate(11 64 106)" />
            <path class="flame" d="M64 12C74 30 100 46 100 74c0 22-16 34-36 34S28 96 28 74c0-16 8-26 16-34 1 12 6 18 13 20-3-16-1-34 7-48z" fill="#F6C445" />
            <path d="M64 50c6 12 21 20 21 36 0 12-9 19-21 19s-21-7-21-19c0-11 9-20 21-36z" fill="#FFEDB5" />
          </svg>
          kndl
        </a>
        <nav aria-label="Docs">
          <a href={doc("start/quickstart/")}>Quickstart</a>
          <a href={doc("start/introduction/")}>Docs</a>
          <a href="https://github.com/kddige/kndl">GitHub</a>
          <label class="theme">
            <span class="sr">Theme</span>
            <select id="theme">
              <option value="auto">Auto</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
        </nav>
      </header>

      <div class="pitch">
        <div class="pitch-head">
          <h1>Multiplayer agentic sessions.</h1>
        </div>
        <div class="pitch-body">
          <p class="lede">
            kndl is a self-hosted Hub for coding-agent Sessions, on any Provider's Models. Each Session
            works in its own Sandbox on a machine you own. Whoever starts it drives it, and everyone with access to its Repo can
            watch it live.
          </p>
          <div class="install">
            <code><span class="p">$</span> <span id="cmd">{installCmd}</span></code>
            <button type="button" id="copy" aria-label="Copy the install command">Copy</button>
          </div>
          <p class="install-note">
            macOS or Linux, with git.{" "}
            <a href={doc("self-hosting/install/")}>What it installs</a>
          </p>
          <p class="ctas hero-ctas">
            <a class="btn" href={doc("start/quickstart/")}>Get started</a>
            <a class="btn ghost" href="https://github.com/kddige/kndl">GitHub</a>
          </p>
        </div>
      </div>

      <div class="stage">
        <svg class="scene" viewBox="160 0 1440 900" preserveAspectRatio="xMidYMax slice" role="img"
          aria-label="An illustration: a campfire with a face, labelled Session, with two marshmallows with faces sitting on logs either side of it, toasting sticks held towards the flames. On the hill behind are a tent labelled Sandbox and a small fire labelled Runner.">
          <rect class="sky" x="100" width="1560" height="900" />
          <g class="stars" fill="#FFEDB5">
            {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
          </g>

          <path d="M100 620 L300 560 L540 600 L760 520 L980 590 L1240 500 L1460 570 L1660 530 V760 H100 Z" class="ridge" />

          <g>
            <path d="M100 650 C200 620 320 630 440 660 C560 690 640 694 720 694 C860 694 980 660 1120 644 C1260 628 1360 640 1440 664 L1660 650 V900 H100 Z" class="hill" />

            <!-- The tent: a Sandbox. -->
            <g class="aside" transform="translate(405 694) scale(0.78)">
              <path class="tent" d="M-96 0 L0 -108 L96 0 Z" />
              <path class="tent-shade" d="M-96 0 L0 -108 L-8 0 Z" />
              <path d="M-30 0 L0 -60 L30 0 Z" fill="#F6C445" />
              <path d="M-14 0 L0 -32 L14 0 Z" fill="#FFEDB5" />
            </g>
            <text class="tag aside" x="405" y="716" text-anchor="middle">Sandbox</text>

            <!-- The far fire: a Runner. -->
            <g transform="translate(290 680)" class="far aside">
              <rect x="-24" y="0" width="48" height="8" rx="4" fill="#6B4A3A" transform="rotate(-8)" />
              <rect x="-24" y="0" width="48" height="8" rx="4" fill="#8C5F47" transform="rotate(8)" />
              <g class="flick">
                <path class="flame" d="M0 -42 C7 -28 22 -18 22 -4 C22 6 12 10 0 10 S-22 6 -22 -4 C-22 -14 -14 -22 -9 -26 C-8 -16 -5 -12 -1 -10 C-3 -22 -3 -34 0 -42Z" fill="#F6C445" />
                <path d="M0 -20 C4 -12 12 -8 12 0 C12 6 7 8 0 8 S-12 6 -12 0 C-12 -7 -5 -12 0 -20Z" fill="#FFEDB5" />
              </g>
            </g>
            <text class="tag aside" x="290" y="716" text-anchor="middle">Runner</text>

            <path d="M100 730 C240 712 520 726 720 728 C940 730 1200 712 1440 732 L1660 722 V900 H100 Z" class="front" />
            <ellipse cx="720" cy="838" rx="300" ry="40" class="hearth" />

            <defs>
              <clipPath id="mallow-body"><rect x="-28" y="-86" width="56" height="74" rx="18" /></clipPath>
            </defs>
            {mallows.map((m) => (
              <g transform={`translate(${m.x} ${m.y}) scale(${m.dir} 1)`}>
                <rect x="-34" y="-13" width="68" height="13" rx="6.5" fill="#6B4A3A" />
                <g class="mallow" style={`animation-delay: ${m.delay}`}>
                  <path d="M17 -46 L52 -86" stroke="#8C5F47" stroke-width="3.4" stroke-linecap="round" />
                  <g clip-path="url(#mallow-body)">
                    <rect x="-28" y="-86" width="56" height="74" rx="18" fill="#FFEDB5" />
                    <rect x="15" y="-86" width="14" height="74" fill="#F6C445" opacity="0.5" />
                  </g>
                  <rect class="edge" x="-28" y="-86" width="56" height="74" rx="18" />
                  <g fill="#2A1F3D"><ellipse cx="-1" cy="-58" rx="3.2" ry="4.2" /><ellipse cx="14" cy="-58" rx="3.2" ry="4.2" /></g>
                  <g fill="#fff"><circle cx="0.2" cy="-59.6" r="1" /><circle cx="15.2" cy="-59.6" r="1" /></g>
                  <g fill="#F59C8B"><circle cx="-8" cy="-49" r="3.2" /><circle cx="21" cy="-49" r="3.2" /></g>
                  <path d="M3.5 -49q3.5 4.2 7 0" fill="none" stroke="#2A1F3D" stroke-width="2.2" stroke-linecap="round" />
                </g>
              </g>
            ))}

            <!-- Kip, the Session. -->
            <g transform="translate(720 622) scale(2.1) translate(-64 -12)">
              <rect x="28" y="100" width="72" height="13" rx="6.5" fill="#6B4A3A" transform="rotate(-11 64 106)" />
              <rect x="28" y="100" width="72" height="13" rx="6.5" fill="#8C5F47" transform="rotate(11 64 106)" />
              <g class="flick kip">
                <path class="flame" d="M64 12C74 30 100 46 100 74c0 22-16 34-36 34S28 96 28 74c0-16 8-26 16-34 1 12 6 18 13 20-3-16-1-34 7-48z" fill="#F6C445" />
                <path d="M64 50c6 12 21 20 21 36 0 12-9 19-21 19s-21-7-21-19c0-11 9-20 21-36z" fill="#FFEDB5" />
              </g>
              <g fill="#2A1F3D"><ellipse cx="56" cy="85" rx="3.4" ry="4.4" /><ellipse cx="72" cy="85" rx="3.4" ry="4.4" /></g>
              <g fill="#fff"><circle cx="57.2" cy="83.4" r="1.1" /><circle cx="73.2" cy="83.4" r="1.1" /></g>
              <g fill="#F59C8B"><circle cx="49.5" cy="93" r="3.4" /><circle cx="78.5" cy="93" r="3.4" /></g>
              <path d="M59 94q5 5.5 10 0" fill="none" stroke="#2A1F3D" stroke-width="2.6" stroke-linecap="round" />
            </g>
            <text class="tag" x="720" y="878" text-anchor="middle">Session</text>

            <g class="sparks">
              <circle class="sp s1" cx="704" cy="640" r="2.4" />
              <circle class="sp s2" cx="740" cy="650" r="1.9" />
              <circle class="sp s3" cx="718" cy="630" r="1.7" />
            </g>
          </g>
        </svg>
      </div>

      <div class="deskwrap">
        <figure class="laptop">
          <div class="lid">
            <img class="t-light" src={img("laptop")} width="1588" height="1400" alt="kndl's web UI: a Session named Retry payment calls on timeout, active, with three Participants. Claude is mid-Turn, two prompts wait in the Prompt queue with Steer buttons, and a Runners and Environments sidebar lists the Repos." />
<img class="t-dark" src={img("laptop-dark")} width="1588" height="1400" loading="lazy" alt="" aria-hidden="true" />
          </div>
          <div class="deck" aria-hidden="true"></div>
        </figure>
      </div>
    </section>

    <!-- 2. What it is, in four points. -->
    <section class="points" aria-labelledby="points-h">
      <h2 id="points-h" class="sr">What kndl does</h2>
      <div class="point">
        <h3>Sessions you share</h3>
        <p>
          Everyone with access to a Repo can open its Sessions and follow the agent live. The person
          who started one drives it: their prompts wait in a queue, or join the running Turn with
          <b>Steer</b>.
        </p>
        <a href={doc("guides/work-in-a-session/")}>Work in a Session</a>
      </div>
      <div class="point">
        <h3>A Sandbox per Session</h3>
        <p>
          The agent and every command it runs live in a microVM, built from the Repo's
          Environment. Nothing runs on the host.
        </p>
        <a href={doc("concepts/environments/")}>Environments</a>
      </div>
      <div class="point">
        <h3>On your machines</h3>
        <p>
          The Hub is one Bun process with a SQLite database. Runners are your Macs and Linux boxes,
          and they connect to the Hub, not the other way round.
        </p>
        <a href={doc("concepts/architecture/")}>How kndl works</a>
      </div>
      <div class="point">
        <h3>Your own accounts</h3>
        <p>
          Each person connects their own Providers once: a subscription, an API key or a Claude
          setup token. Only the Sessions they start run on them, and only they prompt them.
        </p>
        <a href={doc("concepts/security-model/")}>The security model</a>
      </div>
    </section>

    <!-- 3. Try it, then remove it. -->
    <section class="close">
      <div class="text">
        <h2>Try it, then remove it</h2>
        <p>
          Run the Hub and a Runner on one machine, start a Session on one of your Repos, and take
          it all away with one command. About 10 minutes.
        </p>
        <p class="ctas">
          <a class="btn" href={doc("start/quickstart/")}>Quickstart</a>
          <a href={doc("start/deploy-for-a-team/")}>Deploy for a team</a>
        </p>
      </div>
      <pre class="term" aria-label="Install, set up and remove kndl"><span class="c"># install</span>
<span class="p">$</span> curl -fsSL https://raw.githubusercontent.com/kddige/kndl/main/install.sh | sh

<span class="c"># set up a Hub and a Runner, and answer its questions</span>
<span class="p">$</span> kndl onboard

<span class="c"># remove it all</span>
<span class="p">$</span> kndl uninstall --purge</pre>
    </section>

    <footer>
      <span>kndl is said "kindle". The screenshots are the real web UI showing made-up Sessions, Repos and people (acme/shop, mira, sione, jo). No Claude ran.</span>
      <span><a href={doc("start/introduction/")}>Docs</a> · <a href={doc("reference/commands/")}>Commands</a> · <a href="https://github.com/kddige/kndl">GitHub</a> · MIT licensed · Not affiliated with Anthropic</span>
    </footer>

    <script is:inline>
      const copy = document.getElementById("copy")
      const cmd = document.getElementById("cmd")
      copy?.addEventListener("click", async () => {
        const text = cmd.textContent.trim()
        try {
          await navigator.clipboard.writeText(text)
        } catch {
          const area = document.createElement("textarea")
          area.value = text
          area.setAttribute("readonly", "")
          area.style.position = "fixed"
          area.style.opacity = "0"
          document.body.append(area)
          area.select()
          document.execCommand("copy")
          area.remove()
        }
        copy.textContent = "Copied"
        setTimeout(() => (copy.textContent = "Copy"), 1800)
      })

      // The theme picker: the docs pages' three choices, under the same localStorage key.
      const key = "starlight-theme"
      const picker = document.getElementById("theme")
      const darkScheme = matchMedia("(prefers-color-scheme: dark)")
      const stored = () => {
        try { return localStorage.getItem(key) } catch { return null }
      }
      const current = () => (stored() === "light" || stored() === "dark" ? stored() : "auto")
      const apply = (choice) => {
        const dark = choice === "dark" || (choice === "auto" && darkScheme.matches)
        document.documentElement.dataset.theme = dark ? "dark" : "light"
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#1b1823" : "#fbf6ea")
      }
      picker.value = current()
      picker.addEventListener("change", () => {
        const choice = picker.value
        try { localStorage.setItem(key, choice === "auto" ? "" : choice) } catch {}
        apply(choice)
      })
      darkScheme.addEventListener("change", () => current() === "auto" && apply("auto"))
    </script>
  </body>
</html>

<style is:global>
  /* Two themes, the docs' "Paper" palette: cream paper by default, a quiet night under
     [data-theme="dark"]. The values are the docs theme's own; the scene's colours are here too,
     so the campsite is a day scene on paper and a night scene in the dark. */
  :root {
    color-scheme: light;
    --bg: #fbf6ea;
    --ink: #271d18;
    --ink-2: #3f332d;
    --muted: #6b5c51;
    --link: #7a4f38;
    --underline: #e3b032;
    --hover: #271d18;
    --line: #e0d2b8;
    --code-bg: #f4ead6;
    --code-ink: #3a2e28;
    --prompt: #8c5f47;
    --flame: #f6c445;
    --core: #ffedb5;
    --log: #8c5f47;
    --log-dark: #6b4a3a;
    --on-flame: #271d18;
    --shadow: 0 1.1rem 2.6rem -1.6rem rgb(58 40 30 / 0.45);

    /* The day scene. */
    --s-sky: #fbf6ea;
    --s-ridge: #ece0c8;
    --s-hill: #e4d5bb;
    --s-front: #d4bf9f;
    --s-hearth: #c9b08f;
    --s-tent: #c2a88d;
    --s-tent-shade: #ab9078;
    --s-tag: #3f332d;
    --s-tag-o: 1;
    --s-edge: #6b4a3a;
    --s-edge-w: 1.45;
    --s-spark: #d49a2a;
    --s-stars: 0;
    --lid: #3a2e28;
    --lid-line: #2f241f;
    --deck: #6b5c51;

    /* The soil under it, going down towards the logs' brown. */
    --soil: linear-gradient(#ece0c9, #e6d6bb 45%, #dcc7a6);
    --rail: color-mix(in srgb, var(--log) 55%, transparent);

    --pad: clamp(1.2rem, 6vw, 5rem);
    --serif: "Fraunces", Georgia, serif;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #1b1823;
    --ink: #f6eee0;
    --ink-2: #d8cfc2;
    --muted: #a59dab;
    --link: #e3b48f;
    --underline: #b98a2c;
    --hover: #f6c445;
    --line: #332d3b;
    --code-bg: #221e2a;
    --code-ink: #e2d9cb;
    --prompt: #f6c445;
    --on-flame: #1b1823;
    --shadow: 0 1.2rem 3rem -1.5rem rgb(0 0 0 / 0.6);

    /* The night scene. */
    --s-sky: #1b1823;
    --s-ridge: #211d29;
    --s-hill: #27222f;
    --s-front: #15131c;
    --s-hearth: #221e2a;
    --s-tent: #3a3443;
    --s-tent-shade: #322c3b;
    --s-tag: #f6eee0;
    --s-tag-o: 0.6;
    --s-edge: transparent;
    --s-edge-w: 0;
    --s-spark: #f6c445;
    --s-stars: 1;
    --lid: #27222f;
    --lid-line: #3a3443;
    --deck: #3a3443;

    --soil: linear-gradient(#1f1b27, #241f29 45%, #2e2420);
    --rail: color-mix(in srgb, var(--flame) 35%, transparent);
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--serif);
    font-variation-settings: "SOFT" 100;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  a { color: var(--link); text-underline-offset: 0.2em; text-decoration-thickness: 2px; text-decoration-color: var(--underline); }
  a:hover { color: var(--hover); }
  :focus-visible { outline: 2px solid #e3b032; outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  h1, h2 { font-family: var(--serif); font-variation-settings: "SOFT" 100; margin: 0; line-height: 1.08; letter-spacing: -0.015em; text-wrap: balance; }
  h2 { font-size: clamp(1.7rem, 1.1rem + 1.6vw, 2.4rem); font-weight: 700; margin-bottom: 1rem; }
  p { margin: 0 0 1em; }
  code { font-family: var(--mono); font-size: 0.82em; }
  img { display: block; max-width: 100%; height: auto; }
  /* A screenshot has a light and a dark copy, and the page's theme picks one. */
  .t-dark { display: none; }
  :root[data-theme="dark"] .t-light { display: none; }
  :root[data-theme="dark"] .t-dark { display: block; }
  .text { max-width: 30rem; }
  .text p { color: var(--ink-2); }
  .text b { font-weight: 600; color: var(--ink); }
  .more { margin: 1.4rem 0 0; font-size: 1rem; }
  .btn { display: inline-block; padding: 0.7rem 1.3rem; border-radius: 999px; background: var(--flame); color: var(--on-flame); font-weight: 700; text-decoration: none; }
  .btn:hover { background: var(--core); color: var(--on-flame); }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--log); }
  .btn.ghost:hover { background: var(--code-bg); color: var(--ink); }
  .hero-ctas { margin-top: 1.2rem; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.6rem; margin: 1.6rem 0 0; }

  /* 1. Hero: on a wide screen the scene fills it and the laptop sits on the ground at the
     right; on a narrow one it stacks: headline, fire, install, laptop. */
  .hero { position: relative; display: flex; flex-direction: column; background: var(--s-sky); overflow: hidden; }
  .top { position: relative; z-index: 3; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.4rem clamp(1.2rem, 4vw, 3rem); }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 800; font-size: 1.4rem; text-decoration: none; color: var(--ink); }
  .brand:hover { color: var(--ink); }
  .top nav { display: flex; align-items: center; gap: 1.6rem; font-size: 0.95rem; }
  .top nav a { text-decoration: none; color: var(--ink-2); }
  .top nav a:hover { color: var(--hover); }
  :root[data-theme="dark"] .top nav a { color: color-mix(in srgb, var(--ink) 78%, var(--bg)); }
