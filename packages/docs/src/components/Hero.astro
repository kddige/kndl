---
// The landing page's hero, replacing Starlight's. Only the landing page has a `hero`, so this is
// its design: the pitch and the actions from the page's frontmatter on the left, and on the right
// a sketch of what kndl is for, one Session several people are in at once.
import { LinkButton } from "@astrojs/starlight/components"

// Starlight's "skip to content" and table of contents link to the page title by this id; its own
// constant isn't exported.
const PAGE_TITLE_ID = "_top"
const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero ?? {}
---

<div class="hero">
  <div class="copy">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Self-hosted · Multiplayer</p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ link: href, text, variant, icon }) => (
            <LinkButton {href} {variant} icon={icon?.name}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>

  <figure class="session" aria-label="A Session three people are in: a shared transcript, a Prompt queue and who is here.">
    <div class="bar">
      <span class="branch">feat/checkout-retry</span>
      <span class="repo">acme/shop</span>
      <span class="people" aria-hidden="true">
        <span class="avatar a1">AL</span><span class="avatar a2">SN</span><span class="avatar a3">MK</span>
      </span>
    </div>
    <ol class="turns">
      <li class="prompt"><span class="who">AL</span> Retry the payment call on timeouts, with backoff.</li>
      <li class="tool"><span class="tag">Bash</span> <code>bun test checkout</code><span class="ok">14 passed</span></li>
      <li class="tool"><span class="tag">Edit</span> <code>src/checkout/pay.ts</code><span class="diff">+18 −3</span></li>
      <li class="reply">Added a retry with exponential backoff and a test for the timeout path.</li>
    </ol>
    <div class="queue">
      <span class="label">Queued</span>
      <span class="who">SN</span> Also log each retry, please.
    </div>
    <figcaption class="where">
      <span><span class="pip host" aria-hidden="true"></span>Claude Code on <b>studio-mac</b></span>
      <span><span class="pip box" aria-hidden="true"></span>tools in its Sandbox</span>
    </figcaption>
  </figure>
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 2.5rem;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
      padding-block: clamp(2.5rem, 8vmin, 6rem) clamp(2.5rem, 6vmin, 4.5rem);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }
  .eyebrow .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--sl-color-accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .tagline {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(var(--sl-text-base), 0.9rem + 0.5vw, var(--sl-text-xl));
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  /* The Session sketch. */
  .session {
    margin: 0;
    border: 1px solid var(--ch-line);
    border-radius: 0.9rem;
    background: var(--ch-surface-raised);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.03) inset,
      0 24px 60px -24px var(--ch-glow),
      0 8px 24px -12px rgb(0 0 0 / 0.25);
    overflow: hidden;
    font-size: var(--sl-text-sm);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--ch-line);
    background: var(--ch-surface);
  }
  .branch {
    font-family: var(--sl-font-mono);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .repo {
    color: var(--sl-color-gray-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .people {
    display: flex;
    margin-inline-start: auto;
  }
  .avatar,
  .who {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    flex: none;
  }
  .avatar {
    border: 2px solid var(--ch-surface);
    margin-inline-start: -0.4rem;
  }
  .a1,
  .prompt .who {
    background: #3d5dcf;
  }
  .a2,
  .queue .who {
    background: #0f8a7e;
  }
  .a3 {
    background: #8a5a12;
  }

  .turns {
    list-style: none;
    margin: 0;
    padding: 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .turns li {
    margin: 0;
  }
  .prompt {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    color: var(--sl-color-white);
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--ch-line);
    border-radius: 0.5rem;
    background: var(--ch-surface);
    color: var(--sl-color-gray-2);
    min-width: 0;
  }
  .tool code {
    background: none;
    padding: 0;
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tag {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .ok,
  .diff {
    margin-inline-start: auto;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .ok {
    color: var(--sl-color-green);
  }
  .diff {
    color: var(--sl-color-gray-3);
  }
  .reply {
    padding-inline-start: 2.1rem;
    color: var(--sl-color-gray-2);
  }
  .queue {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 1rem 1rem;
    padding: 0.55rem 0.7rem;
    border: 1px dashed var(--ch-line);
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
  }
  .label {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--ch-line);
    background: var(--ch-surface);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .where b {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .pip {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: 0.4rem;
    border-radius: 50%;
    vertical-align: 0.05rem;
  }
  .pip.host {
    background: var(--sl-color-accent);
  }
  .pip.box {
    background: var(--sl-color-green);
  }
</style>
