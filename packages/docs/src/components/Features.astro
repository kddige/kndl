---
// The landing page's features: what claude-hub does, each in a sentence or two, linking to where
// the docs explain it.
const base = import.meta.env.BASE_URL

const features = [
  {
    title: "Pair-prompting",
    body: "Everyone in a Session sees the same transcript as it streams. Prompts queue in order, and every Participant has the same rights.",
    href: "explanation/architecture/",
    icon: "people",
  },
  {
    title: "Tools in a Sandbox",
    body: "Claude Code runs on the host; every file and command tool runs in the Session's own microVM, which never sees the host's credentials.",
    href: "explanation/security-model/",
    icon: "shield",
  },
  {
    title: "Your machines, your logins",
    body: "Connect any number of Runners. Each runs Sessions on its own Claude login, shown on every Session it runs.",
    href: "how-to/add-a-runner/",
    icon: "server",
  },
  {
    title: "Environments per Repo",
    body: "An image, a Bootstrap script, a Start script, Docker and dependency folders. A Test build proves a change before anyone applies it.",
    href: "how-to/set-up-an-environment/",
    icon: "box",
  },
  {
    title: "Sessions that sleep",
    body: "Idle Sessions sleep and wake on the next prompt with their conversation, Workspace and caches. Uncommitted work is pushed to a WIP ref.",
    href: "explanation/session-lifecycle/",
    icon: "moon",
  },
  {
    title: "One live terminal",
    body: "The Terminal tab mirrors Claude Code's own screen to everyone, for dialogs, Esc and Ctrl-C. Sensitive values are masked everywhere.",
    href: "explanation/architecture/#the-terminal-mirror",
    icon: "terminal",
  },
]

const icons: Record<string, string> = {
  people:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="16.5" cy="9" r="2.6"/><path d="M15.5 14.2c2.6-.3 4.6 1.3 5 4.3"/>',
  shield: '<path d="M12 3.2 19 6v5.5c0 4.3-3 7.6-7 9.3-4-1.7-7-5-7-9.3V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  server:
    '<rect x="4" y="4" width="16" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="16" height="6.5" rx="1.6"/><path d="M8 7.25h.01M8 16.75h.01"/>',
  box: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
  moon: '<path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/>',
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="m7 9.5 3 2.5-3 2.5M12.5 15h4.5"/>',
}
---

<ul class="features">
  {
    features.map((feature) => (
      <li>
        <a href={`${base}${feature.href}`}>
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[feature.icon]}
          />
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    margin: 0;
  }
  a {
    display: block;
    height: 100%;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--ch-line);
    border-radius: 0.8rem;
    background: var(--ch-surface-raised);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  a:hover,
  a:focus-visible {
    border-color: color-mix(in srgb, var(--sl-color-accent) 60%, var(--ch-line));
  }
  @media (prefers-reduced-motion: no-preference) {
    a:hover {
      transform: translateY(-1px);
    }
  }
  svg {
    display: block;
    color: var(--sl-color-accent);
    margin-bottom: 0.7rem;
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
</style>
