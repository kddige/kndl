---
// The landing page's closing call to action: the three commands that start a Hub on one machine,
// and where to go next.
import { LinkButton } from "@astrojs/starlight/components"

const base = import.meta.env.BASE_URL
---

<section class="start" aria-labelledby="get-started">
  <div class="text">
    <p class="landing-eyebrow">Get started</p>
    <h2 id="get-started">A Hub on your machine in three commands</h2>
    <p>
      Try it on one machine with dev login, no GitHub App needed. Then add Runners, GitHub sign-in
      and Environments as your team needs them.
    </p>
    <div class="actions">
      <LinkButton href={`${base}tutorials/first-session/`} icon="right-arrow">
        Run your first Session
      </LinkButton>
      <LinkButton href={`${base}how-to/install/`} variant="minimal">Install</LinkButton>
    </div>
    <p class="note">
      Runs from a checkout with <code>bun run</code> today. A <code>claude-hub</code> command that installs
      the Hub and Runners as services is coming.
    </p>
  </div>
  <div class="term" role="img" aria-label="Terminal: bun install, bun run web:build, then bun run hub with dev login.">
    <div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
    <pre aria-hidden="true"><code><span class="p">$</span> bun install
<span class="p">$</span> bun run web:build
<span class="p">$</span> HUB_PUBLIC_URL=http://127.0.0.1:7777 \
  CLAUDE_HUB_DEV_LOGIN=1 bun run hub
<span class="c"># then open http://127.0.0.1:7777</span></code></pre>
  </div>
</section>

<style>
  .start {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: 4rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--ch-line);
    border-radius: 1rem;
    background:
      radial-gradient(120% 140% at 0% 0%, var(--ch-glow), transparent 55%), var(--ch-surface);
  }
  @media (min-width: 56rem) {
    .start {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }
  h2 {
    margin: 0.2rem 0 0.75rem;
    font-size: clamp(var(--sl-text-2xl), 1.1rem + 1.6vw, var(--sl-text-3xl));
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .text > p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  .text > .note {
    margin-top: 1.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .term {
    min-width: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid #262a35;
    background: #0e1016;
    box-shadow: 0 20px 50px -28px rgb(0 0 0 / 0.6);
  }
  .bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid #1f232d;
  }
  .bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #2c313d;
  }
  pre {
    margin: 0;
    padding: 1rem 1.1rem 1.2rem;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.7;
    color: #e6e8ee;
    background: transparent;
    border: 0;
  }
  pre code {
    background: none;
    padding: 0;
    color: inherit;
  }
  .p {
    color: #869efc;
    user-select: none;
  }
  .c {
    color: #7d8392;
  }
</style>
