{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "env": {
    "builtin": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-useless-rename": "error",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "eslint/no-new": "warn",
    "eslint/no-extend-native": "error",
    "eslint/no-unneeded-ternary": "warn",
    "eslint/no-useless-concat": "warn",
    "eslint/no-useless-constructor": "warn",

    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-extraneous-class": "warn",

    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],

    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-thenable": "error",
    "unicorn/throw-new-error": "error"
  },
  "overrides": [
    {
      "files": ["packages/web/**"],
      "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react"],
      "env": {
        "browser": true,
        "node": false
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/jsx-key": "error",
        "react/jsx-no-useless-fragment": "warn",
        "react/no-array-index-key": "warn",
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["packages/web/vite.config.ts"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": [
    "prototype/**",
    "**/dist/**",
    "**/.claude-plugin/types/**",
    "packages/mod/plugins/*/hooks/hub-link-lib.js",
    ".agents/**",
    ".claude/**"
  ]
}
