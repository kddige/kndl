{
  "name": "claude-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "hub": "bun run --filter @claude-hub/hub start",
    "runner": "bun run --filter @claude-hub/runner start",
    "web": "bun run --filter @claude-hub/web dev",
    "mod:check": "bun run --filter @claude-hub/mod check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
