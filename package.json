{
  "name": "claude-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "cli": "bun packages/cli/src/main.ts",
    "hub": "bun run --filter @claude-hub/hub start",
    "runner-token": "bun run --filter @claude-hub/hub runner-token",
    "secrets-key": "bun run --filter @claude-hub/hub secrets-key",
    "secrets-reset": "bun run --filter @claude-hub/hub secrets-reset",
    "runner": "bun run mod:build && bun run --filter @claude-hub/runner start",
    "web": "bun run --filter @claude-hub/web dev",
    "web:build": "bun run --filter @claude-hub/web build",
    "mod:build": "bun run --filter @claude-hub/mod build",
    "mod:check": "bun run --filter @claude-hub/mod check",
    "docs:dev": "bun run --filter @claude-hub/docs dev",
    "docs:build": "bun run --filter @claude-hub/docs build"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  }
}
