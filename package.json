{
  "name": "claude-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "hub": "bun run --filter @claude-hub/hub start",
    "runner": "bun run --filter @claude-hub/runner start",
    "web": "bun run --filter @claude-hub/web dev",
    "mod:check": "bun run --filter @claude-hub/mod check"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  }
}
